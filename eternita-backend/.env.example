# Copy to .env for local development. This file contains placeholders only.
PORT=3000
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
# Optional server-side Firebase Admin credential JSON path (never expose to frontend).
FIREBASE_KEY_PATH=<ABSOLUTE_PATH_TO_SERVER_SERVICE_ACCOUNT_JSON>
# Or use Application Default Credentials. Keep credential file outside this repo.
GOOGLE_APPLICATION_CREDENTIALS=<ABSOLUTE_PATH_TO_ADC_CREDENTIAL_JSON>
# Local Firestore emulator (normally set by firebase emulators:exec).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Server-side Gemini key only. Never put this in Expo/client configuration.
GEMINI_API_KEY=<SERVER_SIDE_GEMINI_API_KEY>
# Optional; defaults to 2. Set to 0 only in an intentional local test environment.
DEATH_REPORT_CONFIRMATION_DELAY_MINUTES=2
# CORS is not currently enabled by src/main.ts. Allowed origins are therefore not active.
# Planned explicit-origin setting if CORS is enabled: CORS_ORIGINS=http://localhost:8081,https://your-web-origin.example
