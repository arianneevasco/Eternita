# Copy to .env for local development. This contains placeholders only.
APP_ENV=development
PORT=3000

# Firebase Admin SDK uses ADC when FIREBASE_KEY_PATH is empty.
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
FIREBASE_KEY_PATH=<ABSOLUTE_PATH_TO_SERVER_SERVICE_ACCOUNT_JSON>
# Optional ADC alternative; never give this file to the frontend.
GOOGLE_APPLICATION_CREDENTIALS=<ABSOLUTE_PATH_TO_ADC_CREDENTIAL_JSON>
# Set automatically by firebase emulators:exec for local Firestore tests.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Exact Expo web origins. Replace/add the actual frontend origin as needed.
# Production must list explicit HTTPS origins; wildcard origins are ignored.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Server-only Gemini key. Never put this in Expo/client configuration.
GEMINI_API_KEY=<SERVER_SIDE_GEMINI_API_KEY>

# Defaults to 2 if omitted; unit is minutes.
DEATH_REPORT_CONFIRMATION_DELAY_MINUTES=2
